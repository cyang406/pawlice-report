# Copy to .env at the repository root. Never commit .env.
MYSQL_DATABASE=pawlice_report
MYSQL_USER=pawlice
# Use long alphanumeric passwords: Compose inserts these values into DATABASE_URL.
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
